# PayPhantom — copy to .env and fill in. NEVER commit .env.
# All values are placeholders; no real credentials live in this repo.
PORT=3000
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MOCK=true
GEMINI_API_KEY=
# BSC public RPC (no key needed) used for read-only receipt quotes.
BSC_RPC_URL=https://bsc-dataseed1.binance.org
# EVM wallet that would fund receipt mints (read-only here; no key ever).
RECEIPT_MINTER_ADDRESS=
# Receipt minting is DEFERRED by default (see lib/receipt.js).
RECEIPT_MODE=deferred
